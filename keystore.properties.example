# 릴리스 서명 키. 이 파일을 keystore.properties 로 복사해 채운다 (keystore.properties 는 .gitignore 됨).
# storeFile 은 프로젝트 루트 기준 상대경로.
#
# 키 만들기 (한 번만, 잃어버리면 같은 앱으로 업데이트를 못 낸다 — 비밀번호와 함께 안전한 곳에 백업):
#   keytool -genkeypair -v -keystore kofest-upload.jks -alias kofest-upload \
#     -keyalg RSA -keysize 2048 -validity 10000
storeFile=kofest-upload.jks
storePassword=
keyAlias=kofest-upload
keyPassword=
